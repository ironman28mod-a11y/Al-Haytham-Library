# PostgreSQL Database URL
# Format: postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/alhaytham?sslmode=require

# Google Drive — service account credentials for file storage
# Diambil dari JSON key yang didownload dari Google Cloud Console.
# Cara setup: lihat langkah-langkah di bawah.
GOOGLE_DRIVE_CLIENT_EMAIL=nama@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_DRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# NEXT_PUBLIC_API_URL — untuk mode production (Vercel).
# Isi dengan URL deployment Vercel kamu agar aplikasi menggunakan
# API routes + PostgreSQL + Google Drive (bukan IndexedDB offline).
# Contoh: https://alhaytham-library.vercel.app
NEXT_PUBLIC_API_URL=

# ── Cara setup Google Drive ──────────────────────────────────
#
# 1. Buka Google Cloud Console → Service Accounts.
# 2. Pilih service account → tab "Keys" → "Add Key" → "Create new key" → JSON → Create.
#    File JSON akan ter-download otomatis.
# 3. Dari file JSON ambil:
#    - GOOGLE_DRIVE_CLIENT_EMAIL  = nilai "client_email"
#    - GOOGLE_DRIVE_PRIVATE_KEY   = nilai "private_key"
#      (paste APA ADANYA, termasuk -----BEGIN... sampai -----END-----)
# 4. Buka folder Google Drive kamu di browser:
#    https://drive.google.com/drive/folders/<FOLDER_ID>
#    - GOOGLE_DRIVE_FOLDER_ID     = ID dari URL folder
# 5. Share folder ke client_email di atas (sebagai "Editor").
# 6. Isi ketiga variabel di atas di file .env.local (lokal) dan
#    di Vercel → Settings → Environment Variables (produksi).
# 7. Verifikasi: jalankan `node scripts/verify-google-drive.mjs`.