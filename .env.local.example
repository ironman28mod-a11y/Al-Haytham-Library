# PostgreSQL Database URL
# Format: postgresql://username:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/alhaytham?sslmode=require

# Google Drive — OAuth2 credentials untuk file storage
# Cara setup: lihat langkah-langkah di bawah.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=1V4PZTrcOwhOGZN4tJvx3BiHr9TUO93CB

# NEXT_PUBLIC_API_URL — untuk mode production (Vercel).
# Isi dengan URL deployment Vercel kamu agar aplikasi menggunakan
# API routes + PostgreSQL + Google Drive (bukan IndexedDB offline).
# Contoh: https://alhaytham-library.vercel.app
NEXT_PUBLIC_API_URL=

# ── Cara setup Google Drive (OAuth2) ──────────────────────────
#
# 1. Buka Google Cloud Console (https://console.cloud.google.com)
# 2. Pilih project "al-haytham-library".
# 3. Buka APIs & Services → Enabled APIs → pastikan "Google Drive API" aktif.
#    Kalau belum, klik "+ ENABLE" lalu cari "Google Drive API".
# 4. Buka APIs & Services → Credentials → Create Credentials → OAuth client ID.
#    - Application type: Web application
#    - Name: Al-Haytham Library
#    - Authorized redirect URIs: tambahkan:
#      http://localhost:3000/api/auth/drive/callback
#      (untuk production, tambahkan juga: https://YOUR_DOMAIN/api/auth/drive/callback)
#    - Copy "Client ID" dan "Client Secret".
# 5. Buka https://console.cloud.google.com/apis/credentials/consent
#    - User type: External
#    - App name: Al-Haytham Library
#    - User support email: email kamu
#    - Developer contact: email kamu
#    - Scopes: tambahkan https://www.googleapis.com/auth/drive.file
#    - Test users: tambahkan email Google kamu (ironman28.mod@gmail.com)
#    - Simpan.
# 6. Isi di .env.local:
#    GOOGLE_DRIVE_CLIENT_ID=<dari langkah 4>
#    GOOGLE_DRIVE_CLIENT_SECRET=<dari langkah 4>
#    GOOGLE_DRIVE_FOLDER_ID=<ID folder di Google Drive kamu>
# 7. Jalankan: node scripts/setup-google-drive.mjs
#    Script akan buka browser untuk otorisasi, lalu simpan refresh token otomatis.
# 8. Jalankan: node scripts/verify-google-drive.mjs (untuk memastikan).
